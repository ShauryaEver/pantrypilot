# Copy to .env (never commit it). Load with: node --env-file=.env src/index.js
# Which values are SECRET is marked below. Secret ones go in Secret Manager on Cloud Run (deploy/cloudrun.sh does this).
NODE_ENV=development
PORT=8080

# ---- Core ------------------------------------------------------------------------------------------------------
# SECRET. Required in production. Generate: openssl rand -hex 32
JWT_SECRET=

# ---- AI: pick ONE of the two ways to reach Gemini -------------------------------------------------------------
# A) Gemini API key (easiest locally). SECRET. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# B) Vertex AI (recommended on Google Cloud: no API key, uses the Cloud Run service account).
#    Needs the Vertex AI API enabled and the role "Vertex AI User" on the service account.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Models. Planning needs reasoning; receipt parsing is simple extraction so it uses the cheaper Flash-Lite.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PARSE_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT_MS=25000
# Security + cost: max real model calls per user per UTC day (cache hits are free and not counted)
AI_DAILY_LIMIT=50
# Optional: USD per 1M tokens, only used for the cost estimate in Settings. Check current Google pricing.
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50

# ---- Database: Supabase (production). Leave both empty to use local SQLite (DB_PATH) ---------------------------
# Supabase dashboard -> Project Settings -> API. Run supabase/schema.sql once in the SQL editor first.
SUPABASE_URL=
# SECRET. Use the "service_role" key. It bypasses row-level security: server-side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=
DB_PATH=./data/pantrypilot.db

# ---- Firebase Auth ("Continue with Google") ---------------------------------------------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app. These four are NOT secret.
# Also enable Authentication -> Sign-in method -> Google, and add your domain under Authorized domains.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Server-side verification uses Application Default Credentials on Cloud Run. Locally, EITHER run
# `gcloud auth application-default login` OR paste a service-account JSON on one line here. SECRET.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Store an anonymous log of each agent run in Firestore (Firestore must be created in the Firebase console)
FIRESTORE_AGENT_LOG=false

# ---- BigQuery ------------------------------------------------------------------------------------------------------
# Stream every used/wasted event live (needs role "BigQuery Data Editor" + "BigQuery Job User" on the service account)
BQ_STREAM=false
BQ_DATASET=pantrypilot
BQ_TABLE=waste_events
BQ_PROJECT_ID=
# SECRET. Random string that makes user pseudonyms irreversible. Generate: openssl rand -hex 16
BQ_SALT=
